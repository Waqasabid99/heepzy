# ─────────────────────────────────────────────────────────────
# Heepzy environment variables. Copy to `.env` and fill in.
# NEVER commit real values. On Hostinger, set these in hPanel →
# Websites → (your site) → Node.js → Environment variables.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
# Public base URL of the site (no trailing slash). Used for auth callbacks, emails, CSRF origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (MySQL / MariaDB). Local Docker instance from docker-compose.yml:
DATABASE_URL="mysql://heepzy:heepzy_local_pw@127.0.0.1:3308/heepzy?allowPublicKeyRetrieval=true"
# Hostinger example (host is usually `localhost` when the app runs on the same server):
# DATABASE_URL="mysql://u123456789_heepzy:STRONG_PASSWORD@localhost:3306/u123456789_heepzy"
# Max pooled connections (shared hosting has low per-user limits; keep this small).
DATABASE_POOL_SIZE=5

# Auth (Better Auth). Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encrypts Server Action IDs/closures. Must be stable across deploys/instances.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Signs the guest cart cookie. Generate with: openssl rand -base64 32
CART_COOKIE_SECRET=

# Initial admin (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@heepzy.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Heepzy Admin"

# Paysafe (card / digital wallet payments)
# Environment: TEST or LIVE
PAYSAFE_ENV=TEST
# Server-to-server API key (username:password from the Paysafe Business Portal). Keep secret.
PAYSAFE_API_KEY_USERNAME=
PAYSAFE_API_KEY_PASSWORD=
# Public (single-use-token) API key, base64 "username:password", safe for the browser.
NEXT_PUBLIC_PAYSAFE_PUBLIC_KEY=
PAYSAFE_ACCOUNT_ID=
# HMAC key for verifying webhook signatures.
PAYSAFE_WEBHOOK_HMAC_KEY=

# Email (SMTP) for order confirmations, password resets, etc.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Heepzy <no-reply@heepzy.pk>"

# Uploaded product images (served at /media/*). On Hostinger point this at a persistent folder outside the app build.
UPLOAD_DIR=storage/uploads
