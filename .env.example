# ─────────────────────────────────────────────────────────────
# Heepzy environment variables. Copy to `.env` and fill in.
# NEVER commit real values. On Hostinger, set these in hPanel →
# Websites → (your site) → Node.js → Environment variables.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
# Public base URL of the site (no trailing slash). Used for auth callbacks, emails, CSRF origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (MySQL / MariaDB). Local Docker instance from docker-compose.yml:
DATABASE_URL="mysql://heepzy:heepzy_local_pw@127.0.0.1:3308/heepzy?allowPublicKeyRetrieval=true"
# Hostinger example (host is usually `localhost` when the app runs on the same server):
# DATABASE_URL=
# TiDB Cloud (free "Starter" cluster, used for the Vercel demo). TLS is switched on by
# `sslaccept=strict` (or DATABASE_SSL=true):
# DATABASE_URL=mysql://<prefix>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/heepzy?sslaccept=strict
DATABASE_SSL="mysql://u123456789_heepzy:STRONG_PASSWORD@localhost:3306/u123456789_heepzy"
# Max pooled connections (shared hosting has low per-user limits; keep this small).
DATABASE_POOL_SIZE=5

# Auth (Better Auth). Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encrypts Server Action IDs/closures. Must be stable across deploys/instances.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Signs the guest cart cookie. Generate with: openssl rand -base64 32
CART_COOKIE_SECRET=

# Initial admin (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@heepzy.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Heepzy Admin"

# Safepay (cards & wallets). Dashboard → Developers → API keys / Endpoints.
# Optional: leave these empty and enter the keys in Admin → Settings → Payments
# instead (owner only, stored encrypted). Keys set here take priority.
SAFEPAY_ENVIRONMENT=sandbox
NEXT_PUBLIC_SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
# Webhook endpoint: https://<your-domain>/api/webhooks/safepay → "View shared secret"
SAFEPAY_WEBHOOK_SHARED_SECRET_KEY=
# Encrypts payment keys saved in the admin. Optional (derived from BETTER_AUTH_SECRET
# if empty). Generate: openssl rand -base64 32. Changing it means re-entering the keys.
SECRETS_ENCRYPTION_KEY=

# Email (SMTP) for order confirmations, password resets, etc.

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Heepzy <no-reply@heepzy.pk>"

# Uploaded images. STORAGE_DRIVER: auto (default: Vercel Blob if BLOB_READ_WRITE_TOKEN is set, else
# local disk), disk, or blob.
STORAGE_DRIVER=
# Local disk (served at /media/*). On Hostinger point this at a persistent folder outside the app build.
UPLOAD_DIR=
# Vercel Blob: Project -> Storage -> Create -> Blob (public). Vercel adds this variable for you.
BLOB_READ_WRITE_TOKEN=storage/uploads
