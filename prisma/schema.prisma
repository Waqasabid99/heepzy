// Heepzy — shoe store schema (MySQL / MariaDB via Prisma 7 + mariadb driver adapter)
// Money is stored as DECIMAL(12,2) in PKR. All timestamps are UTC.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ═════════════════════════════════════════════════════════════
// Auth (Better Auth core + admin plugin). Field names are
// dictated by Better Auth — don't rename without updating
// src/lib/auth.js.
// ═════════════════════════════════════════════════════════════

model User {
  id            String    @id @db.VarChar(64)
  name          String    @db.VarChar(120)
  email         String    @unique @db.VarChar(191)
  emailVerified Boolean   @default(false)
  image         String?   @db.VarChar(512)
  phone         String?   @db.VarChar(20)
  // admin plugin
  role          String    @default("user") @db.VarChar(20) // "user" | "admin"
  banned        Boolean?  @default(false)
  banReason     String?   @db.VarChar(255)
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  addresses      Address[]
  cart           Cart?
  orders         Order[]
  reviews        Review[]
  wishlist       WishlistItem[]
  returnRequests ReturnRequest[]
  couponUses     CouponRedemption[]
  auditLogs      AuditLog[]

  @@index([role])
  @@map("users")
}

model Session {
  id             String   @id @db.VarChar(64)
  expiresAt      DateTime
  token          String   @unique @db.VarChar(191)
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.Text
  userId         String   @db.VarChar(64)
  impersonatedBy String?  @db.VarChar(64)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.VarChar(64)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(64)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.VarChar(64)
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Used by Better Auth's database-backed rate limiter.
model RateLimit {
  id          String @id @db.VarChar(64)
  key         String @unique @db.VarChar(191)
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

/// Fixed-window rate limit buckets for app endpoints (src/lib/rate-limit.js).
model RateLimitBucket {
  key     String   @id @db.VarChar(191)
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

// ═════════════════════════════════════════════════════════════
// Store settings (single row, id = 1)
// ═════════════════════════════════════════════════════════════

model StoreSettings {
  id                     Int      @id @default(1)
  storeName              String   @default("Heepzy") @db.VarChar(120)
  supportEmail           String?  @db.VarChar(191)
  supportPhone           String?  @db.VarChar(20)
  whatsappNumber         String?  @db.VarChar(20)
  currency               String   @default("PKR") @db.VarChar(3)
  // Payments
  codEnabled             Boolean  @default(true)
  codMaxOrderAmount      Decimal? @db.Decimal(12, 2)
  cardPaymentsEnabled    Boolean  @default(false)
  // Checkout
  guestCheckoutEnabled   Boolean  @default(true)
  // Returns & refunds
  returnsEnabled         Boolean  @default(true)
  refundsEnabled         Boolean  @default(true)
  returnWindowDays       Int      @default(7)
  returnPolicy           String?  @db.Text
  // Delivery
  freeDeliveryEnabled    Boolean  @default(false)
  freeDeliveryThreshold  Decimal? @db.Decimal(12, 2)
  // Tax
  pricesIncludeTax       Boolean  @default(true)
  // Catalogue
  reviewsEnabled         Boolean  @default(true)
  reviewsRequireApproval Boolean  @default(true)
  lowStockThreshold      Int      @default(5)
  maintenanceMode        Boolean  @default(false)
  updatedAt              DateTime @updatedAt

  @@map("store_settings")
}

// ═════════════════════════════════════════════════════════════
// Catalogue
// ═════════════════════════════════════════════════════════════

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  logoUrl     String?  @db.VarChar(512)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[]
  promotions Promotion[]
  coupons    Coupon[]

  @@map("brands")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(512)
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent     Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]  @relation("CategoryTree")
  products   Product[]
  promotions Promotion[]
  coupons    Coupon[]

  @@index([parentId])
  @@map("categories")
}

model SizeChart {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120) // e.g. "Men's Sneakers", "Women's Heels"
  description String?  @db.Text
  // Optional how-to-measure image
  imageUrl    String?  @db.VarChar(512)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries  SizeChartEntry[]
  products Product[]

  @@map("size_charts")
}

model SizeChartEntry {
  id           String   @id @default(cuid())
  sizeChartId  String
  label        String   @db.VarChar(20) // size shown on the store, e.g. "42" or "UK 8"
  eu           String?  @db.VarChar(10)
  uk           String?  @db.VarChar(10)
  us           String?  @db.VarChar(10)
  footLengthCm Decimal? @db.Decimal(4, 1)
  sortOrder    Int      @default(0)

  sizeChart SizeChart @relation(fields: [sizeChartId], references: [id], onDelete: Cascade)

  @@index([sizeChartId])
  @@map("size_chart_entries")
}

model Product {
  id               String        @id @default(cuid())
  name             String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(220)
  description      String?       @db.Text
  shortDescription String?       @db.VarChar(500)
  brandId          String?
  sizeChartId      String?
  gender           Gender        @default(UNISEX)
  status           ProductStatus @default(DRAFT)
  basePrice        Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  costPrice        Decimal?      @db.Decimal(12, 2)
  material         String?       @db.VarChar(120)
  isFeatured       Boolean       @default(false)
  isTaxable        Boolean       @default(true)
  // Denormalised review stats, updated when a review is approved/removed
  ratingAverage    Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  metaTitle        String?       @db.VarChar(200)
  metaDescription  String?       @db.VarChar(320)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  brand      Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sizeChart  SizeChart?       @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  categories Category[]
  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
  wishlistBy WishlistItem[]
  promotions Promotion[]
  coupons    Coupon[]
  orderItems OrderItem[]

  @@index([status, isFeatured])
  @@index([brandId])
  @@index([gender])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String   @db.VarChar(512)
  alt       String   @db.VarChar(200) // required for accessibility
  color     String?  @db.VarChar(60) // ties an image to a colourway
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// One purchasable SKU = product × colour × size.
model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique @db.VarChar(64)
  barcode           String?  @db.VarChar(64)
  color             String   @db.VarChar(60)
  colorHex          String?  @db.VarChar(7)
  size              String   @db.VarChar(20) // matches SizeChartEntry.label
  price             Decimal? @db.Decimal(12, 2) // overrides Product.basePrice when set
  compareAtPrice    Decimal? @db.Decimal(12, 2)
  stock             Int      @default(0)
  lowStockThreshold Int?
  weightGrams       Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([productId, color, size])
  @@index([stock])
  @@map("product_variants")
}

enum InventoryReason {
  RESTOCK
  SALE
  CANCELLATION
  RETURN
  ADJUSTMENT
  DAMAGED
}

/// Append-only stock ledger for auditability.
model InventoryMovement {
  id        String          @id @default(cuid())
  variantId String
  change    Int // + adds stock, - removes stock
  reason    InventoryReason
  note      String?         @db.VarChar(255)
  orderId   String?
  actorId   String?         @db.VarChar(64)
  createdAt DateTime        @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

model WishlistItem {
  userId    String   @db.VarChar(64)
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("wishlist_items")
}

// ═════════════════════════════════════════════════════════════
// Reviews
// ═════════════════════════════════════════════════════════════

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String       @db.VarChar(64)
  rating             Int          @db.TinyInt // 1..5, validated in app
  title              String?      @db.VarChar(150)
  body               String?      @db.Text
  fit                String?      @db.VarChar(20) // "SMALL" | "TRUE" | "LARGE"
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  adminReply         String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

// ═════════════════════════════════════════════════════════════
// Customers
// ═════════════════════════════════════════════════════════════

enum Province {
  PUNJAB
  SINDH
  KHYBER_PAKHTUNKHWA
  BALOCHISTAN
  ISLAMABAD_CAPITAL_TERRITORY
  GILGIT_BALTISTAN
  AZAD_KASHMIR
}

model Address {
  id         String   @id @default(cuid())
  userId     String   @db.VarChar(64)
  label      String?  @db.VarChar(40) // "Home", "Office"
  fullName   String   @db.VarChar(120)
  phone      String   @db.VarChar(20)
  line1      String   @db.VarChar(255)
  line2      String?  @db.VarChar(255)
  city       String   @db.VarChar(80)
  province   Province
  postalCode String?  @db.VarChar(10)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ═════════════════════════════════════════════════════════════
// Cart (guest carts are keyed by a signed, httpOnly cookie token)
// ═════════════════════════════════════════════════════════════

model Cart {
  id         String    @id @default(cuid())
  userId     String?   @unique @db.VarChar(64)
  guestToken String?   @unique @db.VarChar(64)
  couponCode String?   @db.VarChar(40)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ═════════════════════════════════════════════════════════════
// Pricing: taxes, delivery, promotions, coupons
// ═════════════════════════════════════════════════════════════

model TaxRate {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(80) // e.g. "GST"
  rate      Decimal   @db.Decimal(5, 2) // percent, e.g. 18.00
  province  Province? // null = applies nationwide
  priority  Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tax_rates")
}

model DeliveryZone {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(80) // e.g. "Lahore", "Major cities", "Rest of Pakistan"
  provinces Json? // Province[] — empty/null with no cities = fallback zone
  cities    Json? // string[] (lower-case) — more specific than provinces
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates DeliveryRate[]

  @@map("delivery_zones")
}

model DeliveryRate {
  id               String   @id @default(cuid())
  zoneId           String
  name             String   @db.VarChar(80) // "Standard", "Express"
  price            Decimal  @db.Decimal(12, 2)
  minOrderAmount   Decimal? @db.Decimal(12, 2)
  freeAboveAmount  Decimal? @db.Decimal(12, 2) // per-rate free delivery threshold
  codFee           Decimal? @db.Decimal(12, 2)
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  zone DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@map("delivery_rates")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

/// Automatic sale/offer shown on the storefront (no code needed).
model Promotion {
  id           String       @id @default(cuid())
  name         String       @db.VarChar(120)
  slug         String       @unique @db.VarChar(140)
  description  String?      @db.Text
  bannerUrl    String?      @db.VarChar(512)
  type         DiscountType
  value        Decimal      @db.Decimal(12, 2)
  appliesToAll Boolean      @default(false)
  priority     Int          @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  products   Product[]
  categories Category[]
  brands     Brand[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

/// Voucher / discount code entered at checkout.
model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique @db.VarChar(40) // stored upper-case
  description       String?      @db.VarChar(255)
  type              DiscountType
  value             Decimal      @db.Decimal(12, 2)
  minOrderAmount    Decimal?     @db.Decimal(12, 2)
  maxDiscountAmount Decimal?     @db.Decimal(12, 2)
  appliesToAll      Boolean      @default(true)
  usageLimit        Int?
  usageLimitPerUser Int?         @default(1)
  usedCount         Int          @default(0)
  firstOrderOnly    Boolean      @default(false)
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  products    Product[]
  categories  Category[]
  brands      Brand[]
  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String   @unique
  userId    String?  @db.VarChar(64)
  email     String   @db.VarChar(191)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId, email])
  @@map("coupon_redemptions")
}

// ═════════════════════════════════════════════════════════════
// Orders & payments
// ═════════════════════════════════════════════════════════════

enum OrderStatus {
  PENDING // placed, awaiting confirmation/payment
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  COD
  CARD
  WALLET
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique @db.VarChar(20) // e.g. HZ-260001
  userId        String?       @db.VarChar(64) // null = guest checkout
  email         String        @db.VarChar(191)
  phone         String        @db.VarChar(20)
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod
  currency      String        @default("PKR") @db.VarChar(3)

  subtotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  shippingTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  codFee        Decimal @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)
  refundedTotal Decimal @default(0) @db.Decimal(12, 2)

  couponCode       String? @db.VarChar(40)
  deliveryRateName String? @db.VarChar(80)

  // Shipping address snapshot (orders must not change when an Address is edited)
  shipFullName   String   @db.VarChar(120)
  shipPhone      String   @db.VarChar(20)
  shipLine1      String   @db.VarChar(255)
  shipLine2      String?  @db.VarChar(255)
  shipCity       String   @db.VarChar(80)
  shipProvince   Province
  shipPostalCode String?  @db.VarChar(10)

  customerNote   String? @db.Text
  adminNote      String? @db.Text
  courier        String? @db.VarChar(60)
  trackingNumber String? @db.VarChar(80)

  // Guest order lookup: hashed token emailed to the customer
  accessTokenHash String? @db.VarChar(128)
  ipAddress       String? @db.VarChar(64)

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  refunds          Refund[]
  returnRequests   ReturnRequest[]
  statusHistory    OrderStatusHistory[]
  couponRedemption CouponRedemption?

  @@index([userId, placedAt])
  @@index([email])
  @@index([status, placedAt])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  // Snapshot at time of purchase
  productName String  @db.VarChar(200)
  sku         String  @db.VarChar(64)
  color       String  @db.VarChar(60)
  size        String  @db.VarChar(20)
  imageUrl    String? @db.VarChar(512)
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  returnedQty Int     @default(0)

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?     @db.VarChar(500)
  actorId   String?     @db.VarChar(64) // null = system / customer
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum PaymentProvider {
  COD
  PAYSAFE
}

enum TransactionStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Payment {
  id                String            @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  method            PaymentMethod
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("PKR") @db.VarChar(3)
  status            TransactionStatus @default(INITIATED)
  // Our idempotency key sent to the provider (merchantRefNum for Paysafe)
  merchantRef       String            @unique @db.VarChar(64)
  providerPaymentId String?           @unique @db.VarChar(128)
  failureReason     String?           @db.VarChar(255)
  // Sanitised provider response — never store full card data (PCI)
  providerResponse  Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

/// Raw webhook deliveries, stored for idempotency and debugging.
model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String          @db.VarChar(128)
  eventType   String          @db.VarChar(80)
  payload     Json
  processedAt DateTime?
  error       String?         @db.Text
  createdAt   DateTime        @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ═════════════════════════════════════════════════════════════
// Returns & refunds (toggle via StoreSettings.returnsEnabled / refundsEnabled)
// ═════════════════════════════════════════════════════════════

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  WRONG_SIZE
  DEFECTIVE
  NOT_AS_DESCRIBED
  WRONG_ITEM
  CHANGED_MIND
  OTHER
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
}

model ReturnRequest {
  id           String           @id @default(cuid())
  rmaNumber    String           @unique @db.VarChar(20) // e.g. RMA-260001
  orderId      String
  userId       String?          @db.VarChar(64)
  status       ReturnStatus     @default(REQUESTED)
  reason       ReturnReason
  resolution   ReturnResolution @default(REFUND)
  customerNote String?          @db.Text
  adminNote    String?          @db.Text
  imageUrls    Json? // string[] — photos of the item
  reviewedById String?          @db.VarChar(64)
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items   ReturnItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id              String  @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  condition       String? @db.VarChar(40) // "UNWORN" | "WORN" | "DAMAGED" — set on receipt
  restock         Boolean @default(false)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@map("return_items")
}

enum RefundMethod {
  ORIGINAL_PAYMENT
  BANK_TRANSFER
  WALLET_TRANSFER
  STORE_CREDIT
  CASH
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  paymentId        String?
  returnRequestId  String?
  amount           Decimal      @db.Decimal(12, 2)
  method           RefundMethod
  status           RefundStatus @default(PENDING)
  reason           String?      @db.VarChar(255)
  providerRefundId String?      @db.VarChar(128)
  processedById    String?      @db.VarChar(64)
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("refunds")
}

// ═════════════════════════════════════════════════════════════
// Content & audit
// ═════════════════════════════════════════════════════════════

model Banner {
  id        String    @id @default(cuid())
  title     String    @db.VarChar(150)
  subtitle  String?   @db.VarChar(255)
  imageUrl  String    @db.VarChar(512)
  imageAlt  String    @db.VarChar(200)
  href      String?   @db.VarChar(512)
  placement String    @default("HOME_HERO") @db.VarChar(40)
  sortOrder Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([placement, isActive])
  @@map("banners")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique @db.VarChar(191)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@map("newsletter_subscribers")
}

/// Every admin mutation should write one of these.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @db.VarChar(64)
  action    String   @db.VarChar(80) // e.g. "product.update", "order.refund"
  entity    String   @db.VarChar(60)
  entityId  String?  @db.VarChar(64)
  metadata  Json?
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
